# Скопируй этот файл в .env и впиши свои значения.

# Токен от @BotFather
BOT_TOKEN=

# Telegram ID мастеров/админов через запятую (узнать свой ID: команда /id в боте)
ADMIN_IDS=

# --- Необязательные настройки (ниже значения по умолчанию) ---
SALON_NAME=Барбершоп «Демо»
TIMEZONE=Europe/Moscow
# Часы работы и шаг сетки записи в минутах
WORK_START=10:00
WORK_END=20:00
SLOT_STEP=30
# На сколько дней вперёд можно записаться
DAYS_AHEAD=14
# За сколько часов до визита напоминать (через запятую)
REMINDER_HOURS=24,2
# Максимум активных записей у одного клиента
MAX_ACTIVE_BOOKINGS=3
# Путь к файлу базы (относительно папки проекта)
DB_PATH=data/bot.db
